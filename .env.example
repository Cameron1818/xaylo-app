PORT=3000
PUBLIC_BASE_URL=https://app.example.com
DATABASE_URL=postgres://xaylo:xaylo@localhost:5432/xaylo
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SHARED_SECRET=
GHL_APP_ID=
# 32-byte key as 64 hexadecimal characters; keep stable across deployments.
ENCRYPTION_KEY=
# At least 32 random characters; distinct from ENCRYPTION_KEY.
SESSION_SECRET=
# Local-only preview: also set NODE_ENV=development and PUBLIC_BASE_URL=http://localhost:3000.
DEV_PREVIEW=false

# Standalone email sign-up/sign-in (Resend; verify EMAIL_FROM's domain).
RESEND_API_KEY=
EMAIL_FROM=
# Google OAuth redirect: PUBLIC_BASE_URL/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_ADS_API_VERSION=v26
# Set only if required by your provisioned Google Ads API access.
GOOGLE_ADS_DEVELOPER_TOKEN=
# OpenAI Responses API; choose an available model with Structured Outputs.
OPENAI_API_KEY=
AI_MODEL=
REPORT_SOURCE_MAX_PAGES=20
# Default: 7-day trial, 1 free report total, 7-day reporting lookback.
# Set FREE_TRIAL_DAYS=0 for one free report without a time-limited trial.
FREE_TRIAL_DAYS=7
FREE_REPORT_LOOKBACK_DAYS=7
PAID_REPORTS_PER_MONTH=30
# Create a recurring Stripe Price. No amount is hard-coded in Xaylo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
